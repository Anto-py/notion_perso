# Base PostgreSQL (Postgres.app en local)
DATABASE_URL=postgres://antoninbareau@localhost:5432/notion_perso_dev

# Compte unique, créé par npm run db:seed (sans effet si un compte existe)
INITIAL_USERNAME=
INITIAL_PASSWORD=

# Dossier des fichiers déposés (défaut : ./uploads, ignoré par git ; volume monté sous Coolify)
UPLOAD_DIR=

# Vue publique (/p/…) : nom du site en en-tête (défaut : notion_perso) et
# adresse LinkedIn du pied de page (https://, nom sans lien si absente)
SITE_NAME=
LINKEDIN_URL=
